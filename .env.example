# Clave para los paneles docente y administrador.
HISTORIA_ADMIN_TOKEN=cambia-esta-clave

# Secreto estable para cookies y reconexion de alumnos.
HISTORIA_COOKIE_SECRET=cambia-por-un-secreto-largo

# Puerto HTTP y WebSocket.
# PORT=3000

# Interfaz de red opcional. Dejar comentada para autodeteccion.
# INTERFACE=Wi-Fi

# Base SQLite opcional.
# HISTORIA_DB_PATH=./data/historia-quiz.db

# Nivel de logs opcional.
# LOG_LEVEL=info
